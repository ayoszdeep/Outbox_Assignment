# Copy to .env and fill in your own values. Never commit the real .env.

# ========================
# SERVER
# ========================
PORT=3001
# Where the dashboard runs. Used to redirect back after Slack OAuth.
FRONTEND_URL=http://localhost:3005

# ========================
# DATABASE (PostgreSQL)
# ========================
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=Email_Scheduler
DB_USER=postgres
DB_PASSWORD=change-me
DB_DIALECT=postgres
DB_SSL=false

# ========================
# REDIS (BullMQ queue + rate-limit counters)
# ========================
REDIS_HOST=127.0.0.1
REDIS_PORT=6390

# ========================
# ELASTICSEARCH (email search index)
# ========================
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=emails

# ========================
# THROUGHPUT / RATE LIMITING
# ========================
# Jobs the worker processes in parallel.
WORKER_CONCURRENCY=3
# Minimum gap between two sends for the same sender, in milliseconds.
MIN_DELAY_MS=2000
# Ceiling on emails per sender per hour. Also caps per-sender and per-campaign limits.
MAX_EMAILS_PER_HOUR=100

# ========================
# AUTH
# ========================
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Encrypts stored SMTP passwords (AES-256-GCM).
SMTP_ENCRYPTION_KEY=change-me-32-characters-or-longer

# ========================
# FIREBASE ADMIN (verifies Google sign-in ID tokens)
# Firebase Console > Project settings > Service accounts
# ========================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour\nkey\nhere\n-----END PRIVATE KEY-----\n"

# ========================
# SLACK OAUTH (rate-limit alerts)
# api.slack.com/apps > OAuth & Permissions, scope: incoming-webhook
# ========================
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3001/api/slack/callback
